{
  "name": "nexus",
  "version": "1.1.0",
  "description": "Next Gen Writing App",
  "author": "NEXUS Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:proofreading": "node src/utils/proofreadingHub.test.mjs",
    "test:work-management": "node src/utils/workManagement.test.mjs",
    "test:work-registry": "node src/utils/workRegistry.test.mjs",
    "test:prize-deadlines": "node src/data/literaryPrizes.test.mjs",
    "test:manifest": "node src/utils/manifest.test.mjs",
    "test:export": "node src/utils/exportLayout.test.mjs",
    "benchmark:proofreading": "node tests/proofreading_benchmark.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "diff": "^8.0.4",
    "font-list": "^2.0.2",
    "jszip": "^3.10.1",
    "openai": "^6.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kuromojin": "^3.0.1",
    "textlint": "^15.5.4",
    "textlint-rule-helper": "^2.5.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-prh": "^6.1.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.nexus.antigravity",
    "productName": "NEXUS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "textlint/**/*",
      ".textlintrc.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../nexus_backend",
        "to": "nexus_backend",
        "filter": [
          "bridge_server.py",
          "deterministic_store.py",
          "memory_pack.py",
          "proofreader.py",
          "knowledge_processor.py",
          "config_loader.py",
          "audit_batch_processor.py",
          "nexus_config.json",
          "nexus_whitelist.json",
          "nexus_aliases.json",
          "proofreading_profile.py",
          "proofreading_cli.py"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS"
    }
  }
}
